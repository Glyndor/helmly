# Personal dev scratch space
dev/

# Rust build artifacts
internal/target/
target/
*.rs.bk

# macOS
.DS_Store
**/.DS_Store

# Env files (real ones — .env.example is tracked)
.env
.env.local
.env.*.local

# Playwright
**/playwright-report/
**/test-results/

# FUSE filesystem temp files (Linux file manager / gvfs)
.fuse_hidden*

# Editor
*.swp
*.swo

# Local tooling scratch directories. A global gitignore and .git/info/exclude
# cover them on the maintainer's machine, but neither travels with the repo, so
# on a fresh clone or on CI they were unprotected: a single `git add -A` would
# publish them. Listing them here keeps them out of the tree for everyone.
.claude/
.superpowers/
.playwright-mcp/

# Python bytecode written when the CI scripts run locally
__pycache__/
